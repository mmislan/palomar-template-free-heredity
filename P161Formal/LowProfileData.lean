abbrev lowPairValid (p : ℕ × ℕ) : Prop :=
  0 < p.1 ∧ p.2 ≤ p.1 ∧ 1251 * (p.1 - p.2) ≤ p.1

def lowProfilePilot : List (ℕ × ℕ) :=
  [lowProfilePairs[0]!, lowProfilePairs[15]!, lowProfilePairs[495]!]

set_option maxRecDepth 4096 in
theorem low_profile_pilot :
    lowProfilePilot.all (fun p => decide (lowPairValid p)) = true := by
  decide

set_option maxRecDepth 4096 in
set_option maxHeartbeats 800000 in
theorem low_profile_all :
    lowProfilePairs.all (fun p => decide (lowPairValid p)) = true := by
  decide

theorem low_profile_row (p : ℕ × ℕ) (hp : p ∈ lowProfilePairs) : lowPairValid p := by
  have hall := List.all_eq_true.mp low_profile_all p hp
  exact of_decide_eq_true hall

end P161Formal
